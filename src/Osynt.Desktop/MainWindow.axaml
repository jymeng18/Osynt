<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Osynt.Desktop.ViewModels" xmlns:core="using:Osynt.Core" xmlns:art="using:Osynt.Desktop.Controls"
        x:Class="Osynt.Desktop.MainWindow" x:Name="Root" Title="Osynt · A cozy home for your APIs" Icon="/Assets/osynt.ico"
        Width="1440" Height="940" MinWidth="1080" MinHeight="780" UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen" ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome" ExtendClientAreaTitleBarHeightHint="38">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+Enter" Command="{Binding SendCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="Ctrl+N" Command="{Binding NewRequestCommand}" />
    <KeyBinding Gesture="Meta+Enter" Command="{Binding SendCommand}" />
    <KeyBinding Gesture="Meta+S" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="Meta+N" Command="{Binding NewRequestCommand}" />
  </Window.KeyBindings>
  <Grid RowDefinitions="38,*,28">
    <!-- Quiet, custom desktop chrome. -->
    <Border Background="#EEEFE4" BorderBrush="#DDDFD2" BorderThickness="0,0,0,1" PointerPressed="TitleBarPressed">
      <Grid ColumnDefinitions="260,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="7" Margin="19,0">
          <art:PixelArt Width="15" Height="15" />
          <TextBlock Text="osynt" FontWeight="SemiBold" FontSize="11" Foreground="#66745A" />
          <TextBlock Text="/" Foreground="#B5BAA7" Margin="5,0" />
          <TextBlock Text="Personal workspace" FontSize="10" Foreground="#919783" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="A cozy home for your APIs" FontSize="10" Foreground="#929883" HorizontalAlignment="Center" />
        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <Button Classes="icon" Width="43" Content="−" Click="MinimizeClicked" ToolTip.Tip="Minimize" />
          <Button Classes="icon" Width="43" Content="□" Click="MaximizeClicked" ToolTip.Tip="Maximize or restore" />
          <Button Classes="icon" Width="43" Content="×" Click="CloseClicked" ToolTip.Tip="Close" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="260,*">
      <!-- Collections, with an original little pixel farm. -->
      <Border Background="#F1F2E8" BorderBrush="#E0E3D6" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto">
          <StackPanel Margin="24,26,20,22">
            <StackPanel Orientation="Horizontal" Spacing="9">
              <art:PixelArt Width="39" Height="39" />
              <TextBlock Text="osynt" FontSize="32" FontWeight="SemiBold" Foreground="#4C6340" LetterSpacing="-1.4" />
              <Border Background="#E6E9D9" CornerRadius="4" Padding="6,3" VerticalAlignment="Center" Margin="4,6,0,0">
                <TextBlock Text="BLOOM v0.1" FontSize="8" LetterSpacing="0.8" Foreground="#809069" FontWeight="SemiBold" />
              </Border>
            </StackPanel>
            <TextBlock Text="Small requests. Good things." Foreground="#929682" FontSize="11" Margin="3,9,0,0" />
          </StackPanel>
          <TextBox Grid.Row="1" x:Name="SearchBox" Text="{Binding Search}" Watermark="Find a request…" Margin="19,0,19,18" Background="#FAFAF3" Padding="11,9">
            <TextBox.InnerLeftContent><TextBlock Text="⌕" FontSize="19" Margin="9,0,0,0" Foreground="#9BA18B" /></TextBox.InnerLeftContent>
          </TextBox>
          <Border Grid.Row="2" Background="#E6E9DD" CornerRadius="7" Margin="19,0,19,19" Padding="3">
            <Grid ColumnDefinitions="*,*">
              <Button Classes="nav" Classes.selected="{Binding ShowCollections}" Content="Collections" Command="{Binding NavigationCommand}" CommandParameter="Collections" HorizontalAlignment="Stretch" />
              <Button Grid.Column="1" Classes="nav" Classes.selected="{Binding ShowHistory}" Content="History" Command="{Binding NavigationCommand}" CommandParameter="History" HorizontalAlignment="Stretch" />
            </Grid>
          </Border>
          <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="25,0,20,9">
            <TextBlock Classes="caption" Text="YOUR COLLECTIONS" IsVisible="{Binding ShowCollections}" />
            <TextBlock Classes="caption" Text="RECENT REQUESTS" IsVisible="{Binding ShowHistory}" />
            <Button Grid.Column="1" Classes="icon" Content="+" FontSize="19" Command="{Binding NewRequestCommand}" ToolTip.Tip="New request · Ctrl+N" />
          </Grid>
          <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" Margin="14,0,12,10">
            <Grid>
              <ItemsControl ItemsSource="{Binding Collections}" IsVisible="{Binding ShowCollections}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:LibraryCollection">
                    <StackPanel Margin="0,0,0,10">
                      <Button Classes="collection" Command="{Binding ToggleCommand}" HorizontalAlignment="Stretch">
                        <Grid ColumnDefinitions="15,23,*,Auto">
                          <TextBlock Text="{Binding Chevron}" Foreground="#8B957C" />
                          <TextBlock Grid.Column="1" Text="▱" Foreground="#A58E63" FontSize="18" />
                          <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="12" />
                          <TextBlock Grid.Column="3" Text="{Binding Count}" FontSize="10" Foreground="#9BA18D" Margin="4,0" />
                        </Grid>
                      </Button>
                      <ItemsControl ItemsSource="{Binding Requests}" IsVisible="{Binding Expanded}" Margin="12,0,0,0">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="vm:LibraryRequest">
                            <Button Classes="request" Classes.selected="{Binding IsSelected}" Command="{Binding #Root.DataContext.OpenRequestCommand}" CommandParameter="{Binding}" HorizontalAlignment="Stretch">
                              <Grid ColumnDefinitions="42,*">
                                <TextBlock Text="{Binding Method}" Foreground="{Binding MethodColor}" FontSize="9" FontWeight="Bold" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" />
                              </Grid>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel IsVisible="{Binding ShowHistory}">
                <TextBlock Text="Your adventures will appear here.&#10;Send a request to get started." FontSize="11" Foreground="#919783" Margin="10,16" LineHeight="20" IsVisible="{Binding !HasHistory}" />
                <ItemsControl ItemsSource="{Binding VisibleHistory}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="core:HistoryEntry">
                      <Button Classes="request" Command="{Binding #Root.DataContext.OpenHistoryCommand}" CommandParameter="{Binding}" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="5">
                          <Grid ColumnDefinitions="40,*,Auto">
                            <TextBlock Text="{Binding Request.Method}" FontSize="9" Foreground="#748A5B" FontWeight="Bold" />
                            <TextBlock Grid.Column="1" Text="{Binding Request.Name}" FontSize="11" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{Binding StatusLabel}" FontSize="9" Foreground="#929780" />
                          </Grid>
                          <TextBlock Text="{Binding TimeLabel}" FontSize="9" Foreground="#A3A793" Margin="40,0,0,0" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Clear history" FontSize="10" Foreground="#929783" Command="{Binding ClearHistoryCommand}" IsVisible="{Binding HasHistory}" Margin="5,12" />
              </StackPanel>
            </Grid>
          </ScrollViewer>
          <StackPanel Grid.Row="5" Margin="21,0,21,16" Spacing="14">
            <Button Classes="outline" Command="{Binding NewRequestCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="12,10">
              <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="+" FontSize="16" /><TextBlock Text="New request" FontSize="11" /></StackPanel>
            </Button>
            <Grid ColumnDefinitions="*,*">
              <Button Content="↙  Import" Click="ImportClicked" FontSize="10" HorizontalAlignment="Stretch" />
              <Button Grid.Column="1" Content="↗  Export" Click="ExportClicked" FontSize="10" HorizontalAlignment="Stretch" />
            </Grid>
            <Border Background="#E8EBD9" CornerRadius="7" Padding="13,12">
              <StackPanel Spacing="5">
                <TextBlock Text="A little space to grow." Foreground="#66744F" FontSize="11" FontWeight="Medium" />
                <TextBlock Text="Your requests stay on this device.&#10;No accounts. Just you and your APIs." Foreground="#92967F" FontSize="10" LineHeight="17" />
              </StackPanel>
            </Border>
          </StackPanel>
          <Grid Grid.Row="6" Height="158">
            <art:PixelArt Kind="landscape" Height="128" VerticalAlignment="Bottom" />
            <TextBlock Text="a good day to make something" FontSize="9" Foreground="#8F9B7D" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0" />
          </Grid>
        </Grid>
      </Border>

      <Grid Grid.Column="1" RowDefinitions="49,*">
        <!-- Open request tabs. -->
        <Border BorderBrush="#E2E4D9" BorderThickness="0,0,0,1" Background="#F3F3EA">
          <DockPanel>
            <Button DockPanel.Dock="Right" Classes="icon" Content="+" FontSize="20" Command="{Binding NewRequestCommand}" Margin="10,0,16,0" ToolTip.Tip="New request" />
            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding Tabs}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:RequestTab">
                    <Border BorderBrush="#E2E4D9" BorderThickness="0,0,1,0">
                      <Grid ColumnDefinitions="*,26">
                        <Button Classes="tab" Classes.selected="{Binding IsSelected}" Command="{Binding #Root.DataContext.SelectTabCommand}" CommandParameter="{Binding}" Height="49">
                          <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{Binding Document.Method}" Foreground="{Binding MethodColor}" FontWeight="Bold" FontSize="9" />
                            <TextBlock Text="{Binding TabTitle}" FontSize="11" MaxWidth="165" TextTrimming="CharacterEllipsis" />
                            <Ellipse Width="5" Height="5" Fill="#B9A16B" IsVisible="{Binding IsDirty}" />
                          </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Classes="icon" Content="×" Click="CloseTabClicked" Tag="{Binding}" Padding="0" Foreground="#A6AB98" ToolTip.Tip="Close request">
                          <Button.ContextMenu><ContextMenu><MenuItem Header="Discard changes and close" Click="DiscardTabClicked" Tag="{Binding}" /></ContextMenu></Button.ContextMenu>
                        </Button>
                        <Border Grid.ColumnSpan="2" Height="2" Background="#809565" VerticalAlignment="Top" IsVisible="{Binding IsSelected}" IsHitTestVisible="False" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Border>

        <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,170,10,*,Auto" Margin="30,24,30,15">
          <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,23">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="1,0,0,10">
                <TextBlock Text="Collections" FontSize="10" Foreground="#A0A28E" />
                <TextBlock Text="/" Foreground="#C1C3B2" FontSize="10" />
                <TextBlock Text="{Binding CollectionLabel}" FontSize="10" Foreground="#869276" />
              </StackPanel>
              <TextBox x:Name="RequestName" Classes="title" Text="{Binding Selected.Document.Name}" MaxWidth="640" HorizontalAlignment="Left" Watermark="Name your request" ToolTip.Tip="Click to rename this request" />
              <TextBlock Text="A little curiosity. A little code. See what comes back." Foreground="#9B9C8C" FontSize="11" Margin="1,6,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="17">
              <Button Classes="outline" Click="EnvironmentClicked" Padding="11,8" ToolTip.Tip="Edit environment variables">
                <StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Width="6" Height="6" Fill="#8B9F6D" /><TextBlock Text="{Binding EnvironmentLabel}" FontSize="10" /><TextBlock Text="⌄" Foreground="#9AA18B" /></StackPanel>
              </Button>
              <Button Classes="outline" Command="{Binding SaveCommand}" HorizontalAlignment="Right" Padding="12,7" ToolTip.Tip="Save request · Ctrl+S">
                <StackPanel Orientation="Horizontal" Spacing="7"><TextBlock Text="▣" Foreground="#89967A" /><TextBlock Text="Save request" FontSize="10" /><TextBlock Text="Ctrl S" FontSize="8" Foreground="#B0B4A3" Margin="5,0,0,0" /></StackPanel>
              </Button>
            </StackPanel>
          </Grid>

          <!-- Real HTTP request editor. -->
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,0,0,9">
            <Border BorderBrush="#DCE1CF" BorderThickness="1" CornerRadius="7" Background="#FFFDF8">
              <Grid ColumnDefinitions="104,1,*">
                <ComboBox x:Name="MethodPicker" ItemsSource="{Binding Methods}" SelectedItem="{Binding Selected.Document.Method}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Padding="14,11" />
                <Border Grid.Column="1" Background="#E6E8DD" Margin="0,11" />
                <TextBox Grid.Column="2" x:Name="UrlInput" Text="{Binding Selected.Document.Url}" Watermark="https://your-little-api.com" BorderThickness="0" FontFamily="Cascadia Code, DejaVu Sans Mono, Consolas, monospace" Padding="15,14" FontSize="12" Background="Transparent" VerticalContentAlignment="Center" />
              </Grid>
            </Border>
            <Button Grid.Column="1" x:Name="SendButton" Classes="primary" Command="{Binding SendCommand}" MinWidth="145" ToolTip.Tip="Send request · Ctrl+Enter">
              <StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="{Binding Selected.SendLabel}" /><TextBlock Text="↗" FontSize="17" /></StackPanel>
            </Button>
          </Grid>

          <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal">
              <Button Classes="section" Classes.selected="{Binding ParamsActive}" Command="{Binding EditorCommand}" CommandParameter="Params">
                <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="Params" /><TextBlock Text="{Binding Selected.Document.Parameters.Count}" FontSize="9" Foreground="#9AA68C" /></StackPanel>
              </Button>
              <Button Classes="section" Classes.selected="{Binding HeadersActive}" Command="{Binding EditorCommand}" CommandParameter="Headers">
                <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="Headers" /><TextBlock Text="{Binding Selected.Document.Headers.Count}" FontSize="9" Foreground="#9AA68C" /></StackPanel>
              </Button>
              <Button Classes="section" Classes.selected="{Binding BodyActive}" Content="Body" Command="{Binding EditorCommand}" CommandParameter="Body" />
              <Button Classes="section" Classes.selected="{Binding NotesActive}" Content="Field notes" Command="{Binding EditorCommand}" CommandParameter="About" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="A PLACE FOR THE DETAILS" Classes="caption" FontSize="8" LetterSpacing="1" />
          </Grid>

          <Border Grid.Row="3" BorderBrush="#E1E5D7" BorderThickness="1" CornerRadius="0,6,6,6" Background="#FFFDF8" ClipToBounds="True">
            <Grid>
              <Grid IsVisible="{Binding ParamsActive}" RowDefinitions="31,*,34">
                <Grid ColumnDefinitions="40,2*,3*,35" Background="#F1F3E9">
                  <TextBlock Grid.Column="1" Text="KEY" Classes="caption" FontSize="8" Margin="10,0" />
                  <TextBlock Grid.Column="2" Text="VALUE" Classes="caption" FontSize="8" Margin="10,0" />
                </Grid>
                <ScrollViewer Grid.Row="1">
                  <ItemsControl ItemsSource="{Binding Selected.Document.Parameters}">
                    <ItemsControl.ItemTemplate><DataTemplate DataType="core:RequestPair">
                      <Border BorderBrush="#EFF0E7" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="40,2*,3*,35">
                          <CheckBox IsChecked="{Binding Enabled}" HorizontalAlignment="Center" RenderTransform="scale(0.8)" />
                          <TextBox Grid.Column="1" Classes="cell" Text="{Binding Key}" Watermark="Parameter" />
                          <TextBox Grid.Column="2" Classes="cell" Text="{Binding Value}" Watermark="Value or {{variable}}" Foreground="#9B936F" />
                          <Button Grid.Column="3" Classes="icon" Content="×" Command="{Binding #Root.DataContext.RemovePairCommand}" CommandParameter="{Binding}" ToolTip.Tip="Remove parameter" Foreground="#B6BAA9" />
                        </Grid>
                      </Border>
                    </DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
                <Grid Grid.Row="2" ColumnDefinitions="Auto,*" Margin="9,0">
                  <Button Content="+  Add parameter" Command="{Binding AddPairCommand}" FontSize="10" Foreground="#8A9A76" Padding="8,5" />
                  <TextBlock Grid.Column="1" Text="Variables are little shortcuts. Try {{season}}." FontSize="9" Foreground="#AFB29F" HorizontalAlignment="Right" Margin="0,0,8,0" />
                </Grid>
              </Grid>
              <Grid IsVisible="{Binding HeadersActive}" RowDefinitions="31,*,34">
                <Grid ColumnDefinitions="40,2*,3*,35" Background="#F1F3E9"><TextBlock Grid.Column="1" Text="KEY" Classes="caption" FontSize="8" Margin="10,0" /><TextBlock Grid.Column="2" Text="VALUE" Classes="caption" FontSize="8" Margin="10,0" /></Grid>
                <ScrollViewer Grid.Row="1"><ItemsControl ItemsSource="{Binding Selected.Document.Headers}">
                  <ItemsControl.ItemTemplate><DataTemplate DataType="core:RequestPair">
                    <Border BorderBrush="#EFF0E7" BorderThickness="0,0,0,1"><Grid ColumnDefinitions="40,2*,3*,35">
                      <CheckBox IsChecked="{Binding Enabled}" HorizontalAlignment="Center" RenderTransform="scale(0.8)" />
                      <TextBox Grid.Column="1" Classes="cell" Text="{Binding Key}" Watermark="Header name" />
                      <TextBox Grid.Column="2" Classes="cell" Text="{Binding Value}" Watermark="Header value" />
                      <Button Grid.Column="3" Classes="icon" Content="×" Command="{Binding #Root.DataContext.RemovePairCommand}" CommandParameter="{Binding}" ToolTip.Tip="Remove header" Foreground="#B6BAA9" />
                    </Grid></Border>
                  </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl></ScrollViewer>
                <Button Grid.Row="2" Content="+  Add header" Command="{Binding AddPairCommand}" FontSize="10" Foreground="#8A9A76" Margin="9,0" Padding="8,5" />
              </Grid>
              <Grid IsVisible="{Binding BodyActive}" RowDefinitions="31,*">
                <Grid Background="#F1F3E9" ColumnDefinitions="*,Auto"><TextBlock Text="REQUEST BODY · RAW TEXT / JSON" Classes="caption" FontSize="8" Margin="15,0" /><Button Grid.Column="1" Content="{}{ }  Format JSON" Command="{Binding FormatBodyCommand}" FontSize="10" Foreground="#899774" Padding="12,5" /></Grid>
                <TextBox Grid.Row="1" x:Name="BodyInput" Classes="code" Text="{Binding Selected.Document.Body}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" Watermark="Plant a little JSON here…" Padding="16,12" Foreground="#748461" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
              </Grid>
              <StackPanel IsVisible="{Binding NotesActive}" Margin="20,18" Spacing="8">
                <TextBlock Text="A few notes from the garden" FontWeight="Medium" FontSize="13" Foreground="#6F8259" />
                <TextBlock Text="Use {{base_url}} for your API address, and {{season}} for a change of scenery.&#10;Edit variables in the environment menu. Add an Authorization header if your API needs one.&#10;The local Harvest API supports spring, summer, fall, and winter. Try POST /v1/plant, too." FontSize="11" LineHeight="21" Foreground="#939A85" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </Border>

          <GridSplitter Grid.Row="4" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" HorizontalAlignment="Stretch" Background="Transparent" VerticalAlignment="Stretch">
            <GridSplitter.Template><ControlTemplate><Grid Background="Transparent"><Border Height="2" Width="30" Background="#D8DECC" CornerRadius="1" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid></ControlTemplate></GridSplitter.Template>
          </GridSplitter>

          <!-- Response: empty, loading, failure, and real HTTP results. -->
          <Border Grid.Row="5" BorderBrush="#E0E4D6" BorderThickness="1" CornerRadius="7" Background="#FFFDF8" ClipToBounds="True">
            <Grid RowDefinitions="48,*,34">
              <Border Background="#F2F4EA" BorderBrush="#E5E8DC" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="17,0">
                  <StackPanel Orientation="Horizontal" Spacing="9"><art:PixelArt Kind="mail" Width="18" Height="18" /><TextBlock Text="Response" FontSize="12" FontWeight="SemiBold" /></StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="18" HorizontalAlignment="Right" IsVisible="{Binding Selected.HasResponse}" Margin="15,0,20,0">
                    <Border Background="#E2EBD7" CornerRadius="4" Padding="8,4" IsVisible="{Binding Selected.IsSuccess}"><TextBlock Text="{Binding Selected.Status}" Foreground="#66804C" FontSize="10" FontWeight="Medium" /></Border>
                    <Border Background="#F1E1D5" CornerRadius="4" Padding="8,4" IsVisible="{Binding Selected.IsFailure}"><TextBlock Text="{Binding Selected.Status}" Foreground="#A47856" FontSize="10" /></Border>
                    <TextBlock Text="{Binding Selected.Duration}" FontSize="10" Foreground="#929A82" />
                    <TextBlock Text="{Binding Selected.Size}" FontSize="10" Foreground="#929A82" />
                  </StackPanel>
                  <Button Grid.Column="2" Classes="icon" Content="⧉" Click="CopyResponseClicked" IsEnabled="{Binding Selected.HasResponse}" ToolTip.Tip="Copy response" Foreground="#96A087" />
                </Grid>
              </Border>
              <Grid Grid.Row="1">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" IsVisible="{Binding Selected.ShowEmpty}">
                  <art:PixelArt Width="43" Height="43" HorizontalAlignment="Center" Opacity="0.7" />
                  <TextBlock Text="{Binding Selected.EmptyTitle}" Foreground="#84956F" HorizontalAlignment="Center" FontSize="15" />
                  <TextBlock Text="{Binding Selected.EmptyHint}" Foreground="#ADB29F" HorizontalAlignment="Center" FontSize="10" />
                </StackPanel>
                <StackPanel IsVisible="{Binding Selected.HasError}" VerticalAlignment="Center" Margin="35" Spacing="12">
                  <TextBlock Text="A little bump in the path." Foreground="#A58260" FontSize="18" FontWeight="Medium" />
                  <SelectableTextBlock Text="{Binding Selected.Error}" Foreground="#9A9380" FontSize="12" TextWrapping="Wrap" />
                  <TextBlock Text="Check your URL, environment variables, and connection. Then try again." Foreground="#AFB09B" FontSize="10" />
                </StackPanel>
                <Grid IsVisible="{Binding Selected.HasResponse}" RowDefinitions="41,*">
                  <Grid ColumnDefinitions="*,Auto" Margin="17,0">
                    <StackPanel Orientation="Horizontal">
                      <Button Classes="section" Classes.selected="{Binding ResponseBodyActive}" Content="Body" Command="{Binding ResponsePaneCommand}" CommandParameter="Body" Padding="0,11" Margin="0,0,20,0" FontSize="10" />
                      <Button Classes="section" Classes.selected="{Binding ResponseHeadersActive}" Content="Headers" Command="{Binding ResponsePaneCommand}" CommandParameter="Headers" Padding="0,11" FontSize="10" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="3" IsVisible="{Binding ResponseBodyActive}">
                      <Button Classes="segment" Classes.selected="{Binding Selected.Pretty}" Content="Pretty" Command="{Binding PrettyCommand}" CommandParameter="Pretty" FontSize="9" />
                      <Button Classes="segment" Classes.selected="{Binding Selected.Raw}" Content="Raw" Command="{Binding PrettyCommand}" CommandParameter="Raw" FontSize="9" />
                    </StackPanel>
                  </Grid>
                  <art:CodeViewer Grid.Row="1" Code="{Binding Selected.ResponseDisplay}" Highlight="{Binding Selected.Pretty}" IsVisible="{Binding ResponseBodyActive}" />
                  <ScrollViewer Grid.Row="1" IsVisible="{Binding ResponseHeadersActive}" Margin="17,8">
                    <ItemsControl ItemsSource="{Binding Selected.ResponseHeaders}"><ItemsControl.ItemTemplate><DataTemplate>
                      <Border BorderBrush="#EFF0E7" BorderThickness="0,0,0,1" Padding="3,9"><Grid ColumnDefinitions="210,*"><TextBlock Text="{Binding Key}" FontSize="11" Foreground="#8C8090" /><SelectableTextBlock Grid.Column="1" Text="{Binding Value}" FontSize="11" Foreground="#849374" TextWrapping="Wrap" /></Grid></Border>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                  </ScrollViewer>
                </Grid>
              </Grid>
              <Border Grid.Row="2" BorderBrush="#EDF0E5" BorderThickness="0,1,0,0">
                <Grid ColumnDefinitions="*,Auto" Margin="16,0">
                  <TextBlock Text="Every response is a little discovery." FontSize="9" Foreground="#A6AD96" />
                  <TextBlock Grid.Column="1" Text="Response limited to 5 MB" Foreground="#AA8B5D" FontSize="9" IsVisible="{Binding Selected.Truncated}" />
                  <Button Grid.Column="1" Content="↧  Save response" Click="SaveResponseClicked" FontSize="9" Foreground="#94A07F" Padding="6,5" IsVisible="{Binding Selected.HasResponse}" />
                </Grid>
              </Border>
            </Grid>
          </Border>

          <Grid Grid.Row="6" ColumnDefinitions="*,Auto" Margin="0,15,0,0">
            <StackPanel Orientation="Horizontal" Spacing="7"><art:PixelArt Kind="sun" Width="14" Height="14" /><TextBlock Text="Take your time. Good things are growing." FontSize="10" Foreground="#A7AB96" /></StackPanel>
            <Button Grid.Column="1" Content="Keyboard shortcuts  ↗" Click="HelpClicked" Padding="0" FontSize="9" Foreground="#A4AA94" />
          </Grid>
        </Grid>
      </Grid>
    </Grid>

    <Border Grid.Row="2" BorderBrush="#DDE2D0" BorderThickness="0,1,0,0" Background="#EBEFE1">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="16,0">
        <StackPanel Orientation="Horizontal" Spacing="7"><Ellipse Width="5" Height="5" Fill="#8CA16D" /><TextBlock Text="All local. All yours." FontSize="9" Foreground="#81916D" /></StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding Notice}" FontSize="9" Foreground="#98A087" Margin="24,0" TextTrimming="CharacterEllipsis" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"><TextBlock Text="made for curious minds" FontSize="9" Foreground="#A0A68E" /><TextBlock Text="♥" Foreground="#B8AC8D" FontSize="10" /></StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
