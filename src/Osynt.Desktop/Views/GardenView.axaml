<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:art="using:Osynt.Desktop.Controls" x:Class="Osynt.Desktop.Views.GardenView">
  <Grid RowDefinitions="*,Auto">
    <Grid x:Name="RendererContainer" MinHeight="220">
      <Border x:Name="RendererFallback" Background="#F3F4E9" Margin="20" CornerRadius="14" BorderBrush="#E0E6D4" BorderThickness="1">
        <Grid RowDefinitions="Auto,*,Auto" Margin="25">
          <Grid ColumnDefinitions="*,Auto">
            <Button Content="←  Requests" Command="{Binding CloseGardenCommand}" HorizontalAlignment="Left" />
            <TextBlock Grid.Column="1" Text="{Binding Garden.Summary}" FontSize="12" Foreground="#8B9D74" />
          </Grid>
          <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" MaxWidth="500">
            <art:PixelArt Width="54" Height="54" HorizontalAlignment="Center" />
            <TextBlock Text="Your garden" FontFamily="Georgia, DejaVu Serif" FontSize="30" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding Garden.LastGrowth}" FontSize="13" Foreground="#8B9D74" HorizontalAlignment="Center" />
            <TextBlock x:Name="RendererStatus" Text="The 3D garden is available in the Windows app." FontSize="12" TextWrapping="Wrap" TextAlignment="Center" LineHeight="21" Foreground="#9AA58A" />
          </StackPanel>
          <ProgressBar Grid.Row="2" Value="{Binding Garden.LevelProgress}" Maximum="100" Height="5" Foreground="#9CB681" Background="#E3EBD6" />
        </Grid>
      </Border>
    </Grid>
    <Border Grid.Row="1" BorderBrush="#E1E6D6" BorderThickness="0,1,0,0" Background="#FFFDF6" Padding="22,15,22,17">
      <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="SEND A REQUEST" FontSize="8" FontWeight="SemiBold" LetterSpacing="1.5" Foreground="#95A082" />
          <TextBlock Grid.Column="1" Text="{Binding Garden.LastGrowth}" FontSize="10" Foreground="#8E9D7B" MaxWidth="340" TextTrimming="CharacterEllipsis" />
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="9">
          <Border Background="#EAF0DF" CornerRadius="5" Padding="11,8"><TextBlock Text="{Binding Requests.Selected.Document.Method}" FontSize="10" FontWeight="SemiBold" Foreground="#6E8756" /></Border>
          <TextBox Grid.Column="1" x:Name="GardenUrlInput" Text="{Binding Requests.Selected.Document.Url}" Watermark="Enter an API URL, or try the local demo →" VerticalContentAlignment="Center" />
          <Button Grid.Column="2" Classes="outline" Content="Try demo" Command="{Binding SendGardenDemoCommand}" Padding="14,8" ToolTip.Tip="Send a real request to the local demo API" />
          <Button Grid.Column="3" x:Name="GardenSendButton" Classes="primary" Content="{Binding Requests.Selected.SendLabel}" Command="{Binding Sending.SendCommand}" Padding="20,8" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
