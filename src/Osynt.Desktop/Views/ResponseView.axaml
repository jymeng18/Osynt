<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Osynt.Desktop.ViewModels" xmlns:art="using:Osynt.Desktop.Controls"
             x:Class="Osynt.Desktop.Views.ResponseView">
  <Border BorderBrush="#E0E4D6" BorderThickness="1" CornerRadius="7" Background="#FFFDF8" ClipToBounds="True">
    <Grid RowDefinitions="42,*,Auto">
      <Border Background="#F2F4EA" BorderBrush="#E5E8DC" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="17,0">
          <StackPanel Orientation="Horizontal" Spacing="9"><TextBlock Text="Response" FontSize="12" FontWeight="SemiBold" /></StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" HorizontalAlignment="Right" IsVisible="{Binding Requests.Selected.HasResponse}" Margin="15,0,20,0">
          <Border Background="#E2EBD7" CornerRadius="4" Padding="8,4" VerticalAlignment="Center" IsVisible="{Binding Requests.Selected.IsSuccess}"><TextBlock Text="{Binding Requests.Selected.Status}" Foreground="#66804C" FontSize="11" FontWeight="Medium" /></Border>
          <Border Background="#F1E1D5" CornerRadius="4" Padding="8,4" VerticalAlignment="Center" IsVisible="{Binding Requests.Selected.IsFailure}"><TextBlock Text="{Binding Requests.Selected.Status}" Foreground="#A47856" FontSize="11" /></Border>
            <TextBlock Text="{Binding Requests.Selected.Duration}" FontSize="11" Foreground="{StaticResource Muted}" />
            <TextBlock Text="{Binding Requests.Selected.Size}" FontSize="11" Foreground="{StaticResource Muted}" />
          </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5">
            <Button Classes="icon" Content="Copy" FontSize="11" Click="CopyResponseClicked" IsEnabled="{Binding Requests.Selected.CanCopyResponse}" ToolTip.Tip="Copy response body" />
            <Button Classes="icon" Content="Save file" FontSize="11" Click="SaveResponseClicked" IsEnabled="{Binding Requests.Selected.HasResponse}" ToolTip.Tip="Save response to a file" />
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="1">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" IsVisible="{Binding Requests.Selected.ShowEmpty}" Margin="20">
          <art:PixelArt Width="30" Height="30" HorizontalAlignment="Center" Opacity="0.7" />
          <TextBlock Text="{Binding Requests.Selected.EmptyTitle}" TextWrapping="Wrap" TextAlignment="Center" Foreground="#84956F" HorizontalAlignment="Center" FontSize="15" />
          <TextBlock Text="{Binding Requests.Selected.EmptyHint}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" FontSize="11" />
        </StackPanel>
        <StackPanel IsVisible="{Binding Requests.Selected.HasError}" VerticalAlignment="Center" Margin="35" Spacing="12">
          <TextBlock Text="Request could not be sent" Foreground="#A58260" FontSize="18" FontWeight="Medium" />
          <SelectableTextBlock Text="{Binding Requests.Selected.Error}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
          <TextBlock Text="Check the address and try again." Foreground="{StaticResource Muted}" FontSize="11" />
        </StackPanel>
        <Grid IsVisible="{Binding Requests.Selected.HasResponse}" RowDefinitions="38,*">
          <Grid ColumnDefinitions="Auto,*,Auto" Margin="17,0">
            <StackPanel Orientation="Horizontal">
              <Button Classes="section" Classes.selected="{Binding Editor.ResponseBodyActive}" Content="Body" Command="{Binding Editor.ResponsePaneCommand}" CommandParameter="Body" />
              <Button Classes="section" Classes.selected="{Binding Editor.ResponseHeadersActive}" Content="Headers" Command="{Binding Editor.ResponsePaneCommand}" CommandParameter="Headers" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding Requests.Selected.ContentType}" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="16,0,8,0" VerticalAlignment="Center" ToolTip.Tip="{Binding Requests.Selected.ContentType}" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="3" IsVisible="{Binding Editor.ResponseBodyActive}">
              <Button Classes="segment" Content="Find" Click="FindClicked" IsEnabled="{Binding Requests.Selected.ShowResponseBody}" FontSize="11" ToolTip.Tip="Find text in response · Ctrl+F" />
              <Button Classes="segment" Classes.selected="{Binding Requests.Selected.Pretty}" Content="Pretty" Command="{Binding Editor.PrettyCommand}" CommandParameter="Pretty" FontSize="11" IsEnabled="{Binding Requests.Selected.ShowResponseBody}" />
              <Button Classes="segment" Classes.selected="{Binding Requests.Selected.Raw}" Content="Raw" Command="{Binding Editor.PrettyCommand}" CommandParameter="Raw" FontSize="11" IsEnabled="{Binding Requests.Selected.ShowResponseBody}" />
            </StackPanel>
          </Grid>
          <Grid Grid.Row="1" IsVisible="{Binding Editor.ResponseBodyActive}">
            <art:CodeViewer x:Name="ResponseCode" Code="{Binding Requests.Selected.ResponseDisplay}" Highlight="{Binding Requests.Selected.Pretty}" IsVisible="{Binding Requests.Selected.ShowResponseBody}" />
            <StackPanel IsVisible="{Binding Requests.Selected.BinaryResponse}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Margin="16">
              <TextBlock Text="Binary response" FontSize="14" Foreground="#7E8D6D" HorizontalAlignment="Center" />
              <TextBlock Text="Save this response to open it in another app." FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel IsVisible="{Binding Requests.Selected.EmptyResponseBody}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
              <TextBlock Text="No response body" FontSize="14" Foreground="#7E8D6D" HorizontalAlignment="Center" />
              <TextBlock Text="The server returned no content. Check the status and headers above." TextWrapping="Wrap" TextAlignment="Center" Margin="16,0" FontSize="11" Foreground="{StaticResource Muted}" />
            </StackPanel>
          </Grid>
          <Grid Grid.Row="1" IsVisible="{Binding Editor.ResponseHeadersActive}" RowDefinitions="Auto,*" Margin="17,8">
            <Button Content="Copy headers" Click="CopyHeadersClicked" HorizontalAlignment="Right" FontSize="11" Padding="8,4" />
            <ScrollViewer Grid.Row="1"><ItemsControl ItemsSource="{Binding Requests.Selected.ResponseHeaders}"><ItemsControl.ItemTemplate><DataTemplate>
              <Border BorderBrush="#EFF0E7" BorderThickness="0,0,0,1" Padding="3,9"><Grid ColumnDefinitions="210,*"><TextBlock Text="{Binding Key}" FontSize="11" Foreground="#8C8090" /><SelectableTextBlock Grid.Column="1" Text="{Binding Value}" FontSize="11" Foreground="#849374" TextWrapping="Wrap" /></Grid></Border>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
          </Grid>
        </Grid>
      </Grid>
      <Border Grid.Row="2" IsVisible="{Binding Requests.Selected.Truncated}" Background="#F6EEDB" Padding="14,8">
        <TextBlock Text="Response exceeds 5 MB. Only this preview is available; saved files also contain only the preview." Foreground="#9A7948" FontSize="11" TextWrapping="Wrap" />
      </Border>
    </Grid>
  </Border>
</UserControl>
