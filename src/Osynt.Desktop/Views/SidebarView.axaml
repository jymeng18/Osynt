<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Osynt.Desktop.ViewModels" xmlns:art="using:Osynt.Desktop.Controls"
             x:Class="Osynt.Desktop.Views.SidebarView">
  <Border Background="#F1F2E8" BorderBrush="#E0E3D6" BorderThickness="0,0,1,0">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
      <StackPanel Orientation="Horizontal" Spacing="9" Margin="20,20,20,20">
        <art:PixelArt Width="27" Height="27" />
        <TextBlock Text="osynt" FontSize="24" FontWeight="SemiBold" Foreground="#4C6340" LetterSpacing="-0.8" />
      </StackPanel>
      <TextBox Grid.Row="1" x:Name="SearchBox" Text="{Binding Library.Search}" Watermark="Find a request…" Margin="14,0,14,14" Background="#FAFAF3" Padding="9,7" AutomationProperties.Name="Search requests" ToolTip.Tip="Search by folder, HTTP method, request name, or URL. Separate words narrow the results.">
        <TextBox.InnerLeftContent><TextBlock Text="⌕" FontSize="19" Margin="9,0,0,0" Foreground="#9BA18B" /></TextBox.InnerLeftContent>
      </TextBox>
      <Border Grid.Row="2" Background="#E6E9DD" CornerRadius="7" Margin="14,0,14,12" Padding="3">
        <Grid ColumnDefinitions="*,*">
          <Button Classes="nav" Classes.selected="{Binding Library.ShowCollections}" Content="Collections" Command="{Binding Library.NavigationCommand}" CommandParameter="Collections" HorizontalAlignment="Stretch" />
          <Button Grid.Column="1" Classes="nav" Classes.selected="{Binding Library.ShowHistory}" Content="History" Command="{Binding Library.NavigationCommand}" CommandParameter="History" HorizontalAlignment="Stretch" />
        </Grid>
      </Border>
      <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="8,0,8,10">
        <StackPanel>
          <StackPanel IsVisible="{Binding Library.EmptyLibrary}" Spacing="8" Margin="12,16">
            <TextBlock x:Name="LibraryEmptyTitle" Text="{Binding Library.EmptyLibraryTitle}" FontSize="12" Foreground="#7E8D6D" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Library.EmptyLibraryHint}" FontSize="11" Foreground="#919783" TextWrapping="Wrap" />
          </StackPanel>
          <ItemsControl ItemsSource="{Binding Library.Collections}" IsVisible="{Binding Library.ShowCollections}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:LibraryCollection">
                <StackPanel Margin="0,0,0,10">
                  <Button Classes="collection" Command="{Binding ToggleCommand}" HorizontalAlignment="Stretch">
                    <Button.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Rename" Click="RenameClicked" Tag="{Binding}" />
                        <MenuItem Header="Delete" Click="DeleteCollectionClicked" Tag="{Binding}" />
                      </ContextMenu>
                    </Button.ContextMenu>
                    <Grid ColumnDefinitions="14,18,*,Auto">
                      <Grid Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Path Data="M 1,2 L 5,6 L 9,2" Stroke="#8B957C" StrokeThickness="1.5" IsVisible="{Binding Expanded}" />
                        <Path Data="M 3,1 L 7,5 L 3,9" Stroke="#8B957C" StrokeThickness="1.5" IsVisible="{Binding !Expanded}" />
                      </Grid>
                      <Viewbox Grid.Column="1" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Path Width="20" Height="20" Data="M 1,4 L 7,4 L 9,6 L 19,6 L 19,17 L 1,17 Z"
                              Fill="#E8DCBF" Stroke="#A58E63" StrokeThickness="1.3" />
                      </Viewbox>
                      <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="12" />
                      <TextBlock Grid.Column="3" Text="{Binding Count}" FontSize="10" Foreground="#9BA18D" Margin="4,0" />
                    </Grid>
                  </Button>
                  <ItemsControl ItemsSource="{Binding Requests}" IsVisible="{Binding Expanded}" Margin="12,0,0,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:LibraryRequest">
                        <Button Classes="request" Classes.selected="{Binding IsSelected}" Command="{Binding $parent[Window].DataContext.OpenRequestCommand}" CommandParameter="{Binding}" HorizontalAlignment="Stretch">
                          <Button.ContextMenu>
                            <ContextMenu>
                              <MenuItem Header="Rename" Click="RenameRequestClicked" Tag="{Binding}" />
                              <MenuItem Header="Delete" Click="DeleteRequestClicked" Tag="{Binding}" />
                            </ContextMenu>
                          </Button.ContextMenu>
                          <Grid ColumnDefinitions="40,*">
                            <TextBlock Text="{Binding Method}" Foreground="{Binding MethodColor}" FontSize="9" FontWeight="Bold" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel IsVisible="{Binding Library.ShowHistory}">
            <ItemsControl ItemsSource="{Binding Library.VisibleHistory}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:HistoryItemViewModel">
                  <Button Classes="request" Command="{Binding $parent[Window].DataContext.OpenHistoryCommand}" CommandParameter="{Binding}" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="5">
                      <Grid ColumnDefinitions="40,*,Auto">
                        <TextBlock Text="{Binding Request.Method}" FontSize="9" Foreground="#748A5B" FontWeight="Bold" />
                        <TextBlock Grid.Column="1" Text="{Binding Request.Name}" FontSize="11" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="{Binding StatusLabel}" FontSize="9" Foreground="#929780" />
                      </Grid>
                      <TextBlock Text="{Binding TimeLabel}" FontSize="9" Foreground="#A3A793" Margin="40,0,0,0" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Clear history" FontSize="10" Foreground="#929783" Command="{Binding Library.ClearHistoryCommand}" IsVisible="{Binding Library.HasHistory}" Margin="5,12" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
      <StackPanel Grid.Row="4">
        <Grid ColumnDefinitions="*,*" Margin="14,0,14,10">
          <Button Content="Import" Click="ImportClicked" FontSize="11" HorizontalAlignment="Stretch" ToolTip.Tip="Import Osynt collections" />
          <Button Grid.Column="1" Content="Export" Click="ExportClicked" FontSize="11" HorizontalAlignment="Stretch" />
        </Grid>
        <Button x:Name="OpenGardenButton" Command="{Binding OpenGardenCommand}" HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch" Background="#E8EEDC" BorderBrush="#DDE5CF" BorderThickness="1"
                CornerRadius="9" Margin="12,0,12,14" Padding="13,12" ToolTip.Tip="Open your 3D garden · Ctrl+G">
          <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7">
              <art:PixelArt Width="18" Height="18" />
              <TextBlock Grid.Column="1" Text="Your garden" FontSize="12" FontWeight="Medium" />
              <TextBlock Grid.Column="2" Text="↗" Foreground="#90A276" />
            </Grid>
            <TextBlock Grid.Row="1" Text="{Binding Garden.Summary}" FontSize="10" Foreground="#8B9A77" />
            <ProgressBar Grid.Row="2" Value="{Binding Garden.LevelProgress}" Maximum="100" Height="4" Foreground="#96AC79" Background="#D9E3CA" />
          </Grid>
        </Button>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
