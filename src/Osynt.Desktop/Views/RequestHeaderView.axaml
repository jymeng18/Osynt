<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Osynt.Desktop.Views.RequestHeaderView">
  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Margin="0,0,0,16">
    <TextBox x:Name="RequestName" Classes="title" Text="{Binding Selected.Document.Name}" Watermark="Untitled request"
             ToolTip.Tip="Rename request" VerticalAlignment="Center" />
    <Button Grid.Column="1" Click="EnvironmentClicked" Content="Variables" Padding="10,8" ToolTip.Tip="Edit {{variables}}" />
    <Button Grid.Column="2" Classes="outline" Command="{Binding SaveCommand}" Content="Save" Padding="16,8" ToolTip.Tip="Save request · Ctrl+S" />
  </Grid>
</UserControl>
