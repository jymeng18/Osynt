<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Osynt.Desktop.Views.RequestHeaderView">
  <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,12">
    <TextBox x:Name="RequestName" AutomationProperties.Name="Request name" Classes="title" Text="{Binding Requests.Selected.Document.Name}" Watermark="Untitled request"
             ToolTip.Tip="Rename request" VerticalAlignment="Center" />
    <Button Grid.Column="1" Content="cURL ▾" ToolTip.Tip="Import or copy a cURL command">
      <Button.Flyout>
        <MenuFlyout>
          <MenuItem Header="Import cURL…" Click="ImportCurlClicked" />
          <MenuItem Header="Copy as cURL" Click="CopyCurlClicked" ToolTip.Tip="Includes resolved variables and credentials" />
        </MenuFlyout>
      </Button.Flyout>
    </Button>
    <Button Grid.Column="2" Click="EnvironmentClicked" Content="Variables" ToolTip.Tip="Edit {{variables}}" />
    <Button Grid.Column="3" Classes="outline" Command="{Binding Requests.SaveCommand}" Content="Save request" Padding="14,8" ToolTip.Tip="Save request · Ctrl+S" />
  </Grid>
</UserControl>
