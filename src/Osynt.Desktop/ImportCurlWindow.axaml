<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Osynt.Desktop.ImportCurlWindow" Title="Import cURL" Width="650" Height="460"
        MinWidth="420" MinHeight="320" WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="24" RowSpacing="14">
    <TextBlock Text="Import cURL" FontSize="21" FontWeight="SemiBold" />
    <TextBlock Grid.Row="1" Text="Paste a single cURL command using Bash/POSIX quotes. The request opens as an unsaved tab; it is sent when you press Send." FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
    <TextBox Grid.Row="2" x:Name="CommandInput" AcceptsReturn="True" AcceptsTab="True" Classes="code" TextWrapping="Wrap" Watermark="curl 'https://api.example.com/items'" AutomationProperties.Name="cURL command" />
    <TextBlock Grid.Row="3" x:Name="ErrorLabel" TextWrapping="Wrap" Foreground="#B78261" FontSize="11" IsVisible="False" />
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Cancel" Click="CancelClicked" IsCancel="True" />
      <Button Content="Import" Click="ImportClicked" Classes="primary" />
    </StackPanel>
  </Grid>
</Window>
