<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Osynt.Desktop.ViewModels"
        x:Class="Osynt.Desktop.EnvironmentWindow" Width="680" Height="460" MinWidth="580" MinHeight="400"
        Title="Environment" WindowStartupLocation="CenterOwner">
  <Grid Margin="28" RowDefinitions="Auto,Auto,*,Auto,Auto">
    <StackPanel Spacing="8" Margin="0,0,0,24">
      <TextBlock Text="Environment variables" FontSize="24" FontWeight="SemiBold" />
      <TextBlock Text="Use {{name}} in requests. Changes save automatically." FontSize="12" Foreground="{StaticResource Muted}" />
    </StackPanel>
    <Grid Grid.Row="1" ColumnDefinitions="2*,3*,30" Margin="10,0,0,10"><TextBlock Text="VARIABLE" Classes="caption" /><TextBlock Grid.Column="1" Text="VALUE" Classes="caption" /></Grid>
    <ScrollViewer Grid.Row="2">
      <ItemsControl x:Name="VariableList"><ItemsControl.ItemTemplate><DataTemplate DataType="vm:RequestPairViewModel">
        <Grid ColumnDefinitions="2*,3*,30" ColumnSpacing="8" Margin="0,0,0,8">
          <TextBox Text="{Binding Key}" Watermark="name" AutomationProperties.Name="Variable name" />
          <TextBox Grid.Column="1" Text="{Binding Value}" Watermark="value" AutomationProperties.Name="Variable value" />
          <Button Grid.Column="2" Classes="icon" Content="×" Tag="{Binding}" Click="RemoveClicked" AutomationProperties.Name="Remove variable" />
        </Grid>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </ScrollViewer>
    <TextBlock Grid.Row="3" x:Name="ErrorLabel" TextWrapping="Wrap" Foreground="#B78261" FontSize="11" Margin="0,8" />
    <Grid Grid.Row="4" ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="9" Margin="0,16,0,0">
      <Button Content="+ Variable" Click="AddClicked" />
      <Button Grid.Column="1" Content="Use local demo" Click="ResetClicked" Foreground="{StaticResource Muted}" FontSize="11" />
      <TextBlock Grid.Column="2" x:Name="SaveStatus" Text="All changes saved" FontSize="11" Foreground="#68735F" VerticalAlignment="Center" HorizontalAlignment="Right" />
      <Button Grid.Column="3" x:Name="RetrySave" Content="Retry save" Click="RetryClicked" IsVisible="False" />
      <Button Grid.Column="4" Classes="primary" Content="Done" Click="DoneClicked" />
    </Grid>
  </Grid>
</Window>
