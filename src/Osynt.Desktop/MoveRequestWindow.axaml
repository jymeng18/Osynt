<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Osynt.Desktop.MoveRequestWindow" Title="Move request" Width="420"
        SizeToContent="Height" CanResize="False" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="24" Spacing="16">
    <TextBlock Text="Move request" FontSize="21" FontWeight="SemiBold" />
    <TextBlock x:Name="RequestLabel" TextWrapping="Wrap" FontSize="12" />
    <ComboBox x:Name="FolderPicker" HorizontalAlignment="Stretch" AutomationProperties.Name="Destination folder" />
    <TextBlock Text="Moves the saved request. Unsaved edits stay in their open tab." FontSize="11" Foreground="#929A85" TextWrapping="Wrap" />
    <TextBlock x:Name="ErrorLabel" TextWrapping="Wrap" Foreground="#B78261" FontSize="11" IsVisible="False" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Cancel" Click="CancelClicked" IsCancel="True" />
      <Button Content="Move" Click="MoveClicked" Classes="primary" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
